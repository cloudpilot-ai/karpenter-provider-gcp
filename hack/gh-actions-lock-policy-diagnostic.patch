+package ghapi
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/cli/go-gh/v2/pkg/api"
+)
+
+// Temporary diagnostics: no URLs, headers, messages, variables, or bodies.
+type policyDiagnosticTransport struct{ inner http.RoundTripper }
+
+func (t policyDiagnosticTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	resp, err := t.inner.RoundTrip(req)
+	if strings.HasSuffix(req.URL.Path, "/graphql") {
+		fields := map[string]any{"stage": "transport", "endpoint": "graphql", "transport_error_type": fmt.Sprintf("%T", err)}
+		if resp != nil {
+			fields["http_status"] = resp.StatusCode
+		}
+		writePolicyDiagnostic(fields)
+	}
+	return resp, err
+}
+
+func diagnosePolicyError(stage string, err error) {
+	if err == nil {
+		return
+	}
+	fields := map[string]any{"stage": stage, "go_error_type": fmt.Sprintf("%T", err), "ip_policy_message": strings.Contains(err.Error(), ipAllowListDenial)}
+	var httpErr *api.HTTPError
+	fields["has_http_error"] = errors.As(err, &httpErr)
+	if httpErr != nil {
+		fields["http_status"] = httpErr.StatusCode
+	}
+	var gqlErr *api.GraphQLError
+	fields["has_graphql_error"] = errors.As(err, &gqlErr)
+	if gqlErr != nil {
+		items := make([]map[string]any, 0, len(gqlErr.Errors))
+		for _, item := range gqlErr.Errors {
+			items = append(items, map[string]any{
+				"type": safeDiagnosticType(item.Type), "path": safeDiagnosticPath(item.Path),
+				"ip_policy_message": strings.Contains(item.Message, ipAllowListDenial),
+			})
+		}
+		fields["graphql_errors"] = items
+	}
+	writePolicyDiagnostic(fields)
+}
+
+func safeDiagnosticType(s string) string {
+	if len(s) <= 64 && strings.Trim(s, "ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789") == "" {
+		return s
+	}
+	return "[other]"
+}
+
+func safeDiagnosticPath(path []any) []string {
+	out := make([]string, 0, len(path))
+	for _, part := range path {
+		s, ok := part.(string)
+		if !ok {
+			out = append(out, "[index]")
+			continue
+		}
+		switch s {
+		case "repo", "commit", "tag", "head", "tagRef", "headRef", "owner", "object", "oid", "compare":
+			out = append(out, s)
+		default:
+			if len(s) > 1 && len(s) < 8 && (s[0] == 'a' || s[0] == 'b') && strings.Trim(s[1:], "0123456789") == "" {
+				out = append(out, s)
+			} else {
+				out = append(out, "[other]")
+			}
+		}
+	}
+	return out
+}
+
+func writePolicyDiagnostic(fields map[string]any) {
+	fields["diagnostic"] = "actions-lock-policy"
+	_ = json.NewEncoder(os.Stderr).Encode(fields)
+}
